TG_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"
TG_CHAT_ID="YOUR_ADMIN_CHAT_ID_HERE"
TG_PROXY=""

# 文件任务留痕（workspace/archive/）。每次文件处理的输入、产物与 run.json
# （用户原话、命中的菜谱、每一轮实际执行的命令）都留在这里，便于事后核对效果。
# 两个配额同时生效，先撞上哪个按哪个回收，最旧优先；任一项设为 0 即关闭该维度。
TG_ARCHIVE_ENABLED="1"
TG_ARCHIVE_MAX_SIZE="10G"
TG_ARCHIVE_MAX_DAYS="14"
