{
  "languages": {
    "Python": {
      "language_servers": [
        "pyright",
        "ruff"
      ]
    }
  },
  "lsp": {
    "pyright": {
      "settings": {
        "python": {
          "pythonPath": "./venv/bin/python",
          "analysis": {
            "typeCheckingMode": "basic",
            "autoSearchPaths": true,
            "useLibraryCodeForTypes": true
          }
        }
      }
    },
    "basedpyright": {
      "settings": {
        "basedpyright": {
          "analysis": {
            "typeCheckingMode": "basic",
            "autoSearchPaths": true,
            "useLibraryCodeForTypes": true
          }
        },
        "python": {
          "pythonPath": "./venv/bin/python"
        }
      }
    }
  }
}
